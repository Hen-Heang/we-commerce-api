# Copy this file to .env and fill in real values for local development.
# DO NOT commit .env — it's gitignored.

# --- Database ---
DB_URL=jdbc:postgresql://localhost:5432/we_commerce
DB_USERNAME=postgres
DB_PASSWORD=your_local_password_here

# --- JWT ---
# Generate a strong secret with: openssl rand -hex 64
# Or any 64+ character hex string. Keep this OUT of git.
JWT_SECRET_KEY=replace_me_with_a_64_char_hex_string
JWT_EXPIRATION=3153600000000
JWT_REFRESH_EXPIRATION=31536000000000
